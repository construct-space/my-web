{
  "name": "@construct-space/ui-web",
  "private": true,
  "version": "0.0.1",
  "description": "Construct UI (browser fork) — Vue 3 components for Construct infra portals. Forked from @construct-space/ui with Tauri-specific pieces removed. Private to @construct-space/my; not published.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./vite": {
      "import": "./src/vite.ts",
      "types": "./src/vite.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "reka-ui": "^2.9.0",
    "@iconify/vue": "^5.0.0",
    "unplugin-auto-import": ">=19.0.0",
    "unplugin-vue-components": ">=28.0.0"
  },
  "peerDependenciesMeta": {
    "unplugin-auto-import": { "optional": true },
    "unplugin-vue-components": { "optional": true }
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "reka-ui": "^2.9.6",
    "typescript": "^6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.3",
    "vue": "^3.5.31",
    "vue-tsc": "^3.2.6"
  }
}
