{
  "name": "@construct-space/infra",
  "version": "0.0.1",
  "description": "Typed HTTP clients for Construct infra services (accounts, developer, source, graph, oracle).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
